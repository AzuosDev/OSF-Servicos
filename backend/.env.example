MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
FRONTEND_URL=
NODE_ENV=development

# Deve corresponder ao domínio real onde o frontend roda (sem isso, o WebAuthn
# usa "localhost" como fallback e falha em qualquer outro domínio/produção)
WEBAUTHN_RP_NAME=OSF Serviços
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
CRON_NOTIFICATIONS=true
NOTIFICATIONS_CRON_TOKEN=

# Gera a mensalidade recorrente (dia 28) e as parcelas em atraso cumulativas
CRON_BILLING=true

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_OSF_SERVICOS_MONTHLY=

ASAAS_API_KEY=
ASAAS_URL=https://api.asaas.com/v3

# OpenRouteService (geocoding + directions) — cálculo de taxa de deslocamento nos orçamentos.
# Sem chave, o cálculo de distância retorna erro tratado (não derruba o servidor).
ORS_API_KEY=
ORS_URL=https://api.openrouteservice.org

# Caminho do executável do Chrome/Edge local, usado apenas em desenvolvimento para gerar PDF
# (em produção na Vercel, o PdfService usa @sparticuz/chromium automaticamente).
PUPPETEER_EXECUTABLE_PATH=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com.br
